				{
					"name": "Find my book",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "eb1fc9bb-d1bc-41ca-bd15-4ec17bbe5313",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"console.log(\"All Books:\", response);",
									"",
									"// 1️⃣ Get all book names",
									"const bookNames = response.map(book => book.name);",
									"console.log(\"All Book Names:\", bookNames);",
									"",
									"// 2️⃣ Pick random book name",
									"const randomBookName = bookNames[Math.floor(Math.random() * bookNames.length)];",
									"console.log(\"Random Book Name:\", randomBookName);",
									"",
									"// 3️⃣ Find book object by random name",
									"const selectedBook = response.find(book => book.name === randomBookName);",
									"console.log(\"Selected Book:\", selectedBook);",
									"",
									"// 4️⃣ Check availability",
									"if (selectedBook && selectedBook.available === true) {",
									"    console.log(\"Book is available ✅\");",
									"",
									"   // pm.environment.set(\"randomBookName\", selectedBook.name);",
									"    pm.collectionVariables.set(\"randomBookId\", selectedBook.id);",
									"   // pm.environment.set(\"randomBookType\", selectedBook.type);",
									"} else {",
									"    console.log(\"Book is NOT available ❌\");",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
