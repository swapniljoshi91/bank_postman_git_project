				{
					"name": "Check Authentication",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "615dd5cb-bd9f-482f-9a86-6aead45da355",
								"exec": [
									"let tokenStore = pm.collectionVariables.get(\"tokenStore\");",
									"tokenStore = tokenStore ? JSON.parse(tokenStore) : {};",
									"",
									"const email = pm.iterationData.get(\"clientEmail\");",
									"const response = pm.response.json();",
									"",
									"// 🔹 CASE 1: Client already registered",
									"if (pm.response.code === 409) {",
									"",
									"    pm.test(\"Client already registered - Status 409\", function () {",
									"        pm.response.to.have.status(409);",
									"    });",
									"",
									"    if (tokenStore[email]) {",
									"        pm.collectionVariables.set(\"Mytoken\", tokenStore[email].token);",
									"        console.log(\"Using existing token for:\", email);",
									"    } else {",
									"        console.warn(\"No token found for already registered client\");",
									"    }",
									"",
									"// 🔹 CASE 2: New client registered",
									"} else if (pm.response.code === 201 || pm.response.code === 200) {",
									"",
									"    pm.test(\"New client registered - Status 201\", function () {",
									"        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"    });",
									"",
									"    tokenStore[email] = {",
									"        token: response.accessToken,",
									"        clientEmail: email,",
									"        createdAt: new Date().toISOString()",
									"    };",
									"",
									"    pm.collectionVariables.set(\"tokenStore\", JSON.stringify(tokenStore));",
									"    pm.collectionVariables.set(\"Mytoken\", response.accessToken);",
									"",
									"    console.log(\"New token stored for:\", email);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
